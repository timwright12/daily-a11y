---
// src/pages/random.astro
import BaseHead from "../components/BaseHead.astro";
import Masthead from "../components/Masthead.astro";
import CriterionApp from "../components/CriterionApp.jsx";
import { getSortedCriteria } from "../lib/criteria.ts";
import "../styles/global.css";
import "../styles/prism-overrides.css";
import "prismjs/themes/prism.css";

const criteria = await getSortedCriteria();
---
<html lang="en">
  <head>
    <BaseHead
      title="Random criterion — Daily Accessibility"
      description="Get a random WCAG 2.2 success criterion to learn, with a plain-language explanation, a code example, and a quick comprehension check."
      canonicalPath="random/"
      noindex
    />
  </head>
  <body>
    <Masthead label="Random criterion" />
    <CriterionApp client:load mode="random" criteria={criteria} />
  </body>
</html>
