---
// src/pages/index.astro
import BaseHead from "../components/BaseHead.astro";
import CriterionApp from "../components/CriterionApp.jsx";
import { getSortedCriteria } from "../lib/criteria.ts";
import "../styles/global.css";
import "../styles/prism-overrides.css";
import "prismjs/themes/prism.css";

const criteria = await getSortedCriteria();
---
<html lang="en">
  <head>
    <BaseHead
      title="Daily Accessibility — A New WCAG Criterion Every Day"
      description="Learn one WCAG 2.2 success criterion a day: a plain-language explanation, who it affects, a code example, and a quick comprehension check. Free, no account needed."
      canonicalPath=""
    />
  </head>
  <body>
    <CriterionApp client:load mode="today" criteria={criteria} />
  </body>
</html>
