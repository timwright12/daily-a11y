---
// src/pages/index.astro
import Masthead from "../components/Masthead.astro";
import CriterionApp from "../components/CriterionApp.jsx";
import { getSortedCriteria } from "../lib/criteria.ts";

const criteria = await getSortedCriteria();
---
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GM2G1R939T"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-GM2G1R939T");
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Daily Accessibility — A New WCAG Criterion Every Day</title>
    <meta
      name="description"
      content="Learn one WCAG 2.2 success criterion a day: a plain-language explanation, who it affects, a code example, and a quick comprehension check. Free, no account needed."
    />
    <link rel="canonical" href="https://timwright12.github.io/daily-a11y/" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Daily Accessibility" />
    <meta property="og:title" content="Daily Accessibility — A New WCAG Criterion Every Day" />
    <meta
      property="og:description"
      content="Learn one WCAG 2.2 success criterion a day: a plain-language explanation, who it affects, a code example, and a quick comprehension check."
    />
    <meta property="og:url" content="https://timwright12.github.io/daily-a11y/" />
    <meta property="og:image" content="https://timwright12.github.io/daily-a11y/favicon.png" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Daily Accessibility — A New WCAG Criterion Every Day" />
    <meta
      name="twitter:description"
      content="Learn one WCAG 2.2 success criterion a day: a plain-language explanation, who it affects, a code example, and a quick comprehension check."
    />
    <meta name="twitter:image" content="https://timwright12.github.io/daily-a11y/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Masthead />
    <CriterionApp client:load mode="today" criteria={criteria} />
  </body>
</html>
