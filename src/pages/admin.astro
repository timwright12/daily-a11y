---
// src/pages/admin.astro
import BaseHead from "../components/BaseHead.astro";
import Masthead from "../components/Masthead.astro";
import CriterionApp from "../components/CriterionApp.jsx";
import { getSortedCriteria } from "../lib/criteria.ts";
import "../styles/global.css";
import "../styles/prism-overrides.css";
import "prismjs/themes/prism.css";

const criteria = await getSortedCriteria();
---
<html lang="en">
  <head>
    <BaseHead
      title="Browse criteria — Daily Accessibility"
      description="Browse every WCAG 2.2 success criterion covered by Daily Accessibility, with plain-language explanations, code examples, and manual testing steps."
      canonicalPath="/daily-a11y/admin/"
      noindex
    />
  </head>
  <body class="admin">
    <Masthead label="Browse criteria" />
    <CriterionApp client:load mode="browse" criteria={criteria} />
  </body>
</html>
