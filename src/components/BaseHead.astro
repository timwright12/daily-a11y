---
// src/components/BaseHead.astro
// Shared <head> content for every page: analytics, charset/viewport, fonts,
// favicon, and the OG/Twitter tags, plus the per-page bits (title,
// description, canonical URL, robots) passed in as props.
interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
}

const { title, description, canonicalPath, noindex = false } = Astro.props;

// canonicalPath is site-root-relative (e.g. "random/"), not base-relative —
// combining it with BASE_URL here keeps every page free of the base path,
// so it only ever needs to change in one place: astro.config.mjs.
const canonicalUrl = new URL(import.meta.env.BASE_URL + canonicalPath, Astro.site);
const ogImageUrl = new URL(import.meta.env.BASE_URL + "favicon.png", Astro.site);
const faviconHref = `${import.meta.env.BASE_URL}favicon.png`;
---

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-GM2G1R939T"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());
  gtag("config", "G-GM2G1R939T");
</script>

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" type="image/png" href={faviconHref} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Daily Accessibility" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />

<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
  rel="stylesheet"
/>
